    <span>&copy; {year} <a href="https://littlesandmeknits.com" class="hover:text-chrome-fg transition-colors">Littles and Me Knits</a></span>
    <div class="flex gap-5">
      <a href="/hjelp" class="hover:text-chrome-fg transition-colors">Hjelp</a>
      <a href="/privacy" class="hover:text-chrome-fg transition-colors">Personvern</a>
      <a href="/terms" class="hover:text-chrome-fg transition-colors">Vilkår</a>
    </div>
  </div>
</footer>
