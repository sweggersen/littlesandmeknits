---
// Server-side storefront renderer. Reconstructs the editor's 2D layout from the
// flat block list: full-width blocks are their own rows; a run of narrower
// blocks becomes a multi-column SECTION whose columns stack INDEPENDENTLY
// (flexbox, content-driven) — so a short Kontakt + Følg rail sits beside a tall
// Om butikken, exactly as placed in the editor. This is what a flat CSS grid
// couldn't do (row-siblings there share a height).
//
// Security: theme + page_config are user JSON, sanitised here (unknown block
// types dropped, theme built only from validated hex + known fonts).
import { storeThemeToCssVars } from '../../lib/store-theme';
import { sanitizePageConfig, GRID_COLUMNS } from '../../lib/store-blocks';
import type { StorefrontListing, StorefrontAsset, StoreBlock, StoreBlockType } from '../../lib/store-blocks';
import type { Store, PublicStorefront } from '../../lib/types/stores';
import StoreBlockCell from './StoreBlockCell.astro';
import type { StoreViewer } from './blocks/types';

interface Props {
  store: Store;
  theme?: unknown;
  pageConfig?: unknown;
  listings?: StorefrontListing[];
  assets?: StorefrontAsset[];
  members?: PublicStorefront['publicMembers'];
  viewer?: StoreViewer;
}

const { store, theme, pageConfig, listings = [], assets = [], members = [], viewer } = Astro.props as Props;

const cssVars = storeThemeToCssVars(theme);
const page = sanitizePageConfig(pageConfig);

// Flow top-to-bottom by y, then left-to-right by x (the visual reading order).
const sorted = [...page.blocks].sort((a, b) => a.layout.y - b.layout.y || a.layout.x - b.layout.x);

// Favourite + follow is a platform-level control, so EVERY storefront shows it,
// even a custom config that predates the block. If the owner placed one we honour
// it; otherwise inject one after the hero.
let blocks = sorted;
if (!sorted.some((b) => b.type === 'storeActions')) {
  const heroIdx = sorted.findIndex((b) => b.type === 'hero');
  const injected: StoreBlock = { id: 'actions-auto', type: 'storeActions' as StoreBlockType, layout: { x: 0, y: 0, w: 12, h: 1 }, props: {} };
  blocks = [...sorted];
  blocks.splice(heroIdx + 1, 0, injected);
}

// Group into sections: a full-width block is a standalone row; a run of narrower
// blocks is a multi-column section (grouped by x into independent columns).
type Column = { x: number; w: number; blocks: StoreBlock[] };
type Section = { kind: 'full'; block: StoreBlock } | { kind: 'cols'; columns: Column[] };

function toColumns(bs: StoreBlock[]): Section {
  const byX = new Map<number, Column>();
  for (const b of bs) {
    const col = byX.get(b.layout.x);
    if (col) { col.blocks.push(b); col.w = Math.max(col.w, b.layout.w); }
    else byX.set(b.layout.x, { x: b.layout.x, w: b.layout.w, blocks: [b] });
  }
  return { kind: 'cols', columns: [...byX.values()].sort((a, b) => a.x - b.x) };
}

const sections: Section[] = [];
let acc: StoreBlock[] = [];
for (const b of blocks) {
  if (b.layout.w >= GRID_COLUMNS) {
    if (acc.length) { sections.push(toColumns(acc)); acc = []; }
    sections.push({ kind: 'full', block: b });
  } else {
    acc.push(b);
  }
}
if (acc.length) sections.push(toColumns(acc));
---

<div class="store-scope" style={cssVars} data-store-scope>
  <div class="store-flow">
    {sections.map((s) => s.kind === 'full' ? (
      <StoreBlockCell block={s.block} store={store} listings={listings} assets={assets} members={members} viewer={viewer} />
    ) : (
      <div class="store-cols">
        {s.columns.map((col) => (
          <div class="store-col" style={`--col-grow:${col.w}`}>
            {col.blocks.map((b) => (
              <StoreBlockCell block={b} store={store} listings={listings} assets={assets} members={members} viewer={viewer} />
            ))}
          </div>
        ))}
      </div>
    ))}
  </div>
</div>
