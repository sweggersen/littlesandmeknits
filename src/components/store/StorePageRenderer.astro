---
// Server-side storefront renderer. Lays sanitised blocks onto a 12-column grid
// inside a `.store-scope` container whose inline style carries the (sanitised)
// theme CSS variables, so the theme cascades to every block AND the shared
// components they reuse (ListingCard etc.).
//
// Security: theme + page_config are user JSON. Both are sanitised here —
// unknown block types are dropped, the theme string is built only from
// validated hex + known font families — before anything reaches the DOM.
import { storeThemeToCssVars } from '../../lib/store-theme';
import { sanitizePageConfig, BLOCK_REGISTRY } from '../../lib/store-blocks';
import type { StorefrontListing, StorefrontAsset, StoreBlockType } from '../../lib/store-blocks';
import type { Store, PublicStorefront } from '../../lib/types/stores';
import StoreHero from './blocks/StoreHero.astro';
import ProductGrid from './blocks/ProductGrid.astro';
import FeaturedProducts from './blocks/FeaturedProducts.astro';
import TextSection from './blocks/TextSection.astro';
import ImageBanner from './blocks/ImageBanner.astro';
import ImageGallery from './blocks/ImageGallery.astro';
import ContactInfo from './blocks/ContactInfo.astro';
import StoreTeam from './blocks/StoreTeam.astro';
import StoreActions from './blocks/StoreActions.astro';
import StoreInfoColumns from './blocks/StoreInfoColumns.astro';
import type { StoreViewer } from './blocks/types';

interface Props {
  store: Store;
  theme?: unknown;
  pageConfig?: unknown;
  listings?: StorefrontListing[];
  assets?: StorefrontAsset[];
  members?: PublicStorefront['publicMembers'];
  viewer?: StoreViewer;
}

const { store, theme, pageConfig, listings = [], assets = [], members = [], viewer } = Astro.props as Props;

const cssVars = storeThemeToCssVars(theme);
const page = sanitizePageConfig(pageConfig);

// Favourite + follow is a platform-level control, so EVERY storefront shows it,
// including stores whose custom page_config predates the block. If the owner
// placed a storeActions block we honour their position; otherwise we inject one
// right after the hero (or at the top when there's no hero) so no store is left
// without it. Owners reposition it by adding the block in the editor.
const sortedBlocks = [...page.blocks].sort((a, b) => a.layout.y - b.layout.y || a.layout.x - b.layout.x);
let blocks = sortedBlocks;
// infoColumns already contains the follow controls, so don't double-inject.
const hasFollow = sortedBlocks.some((b) => b.type === 'storeActions' || b.type === 'infoColumns');
if (!hasFollow) {
  const heroIdx = sortedBlocks.findIndex((b) => b.type === 'hero');
  const injected = { id: 'actions-auto', type: 'storeActions' as StoreBlockType, layout: { x: 0, y: 0, w: 12, h: 1 }, props: {} };
  blocks = [...sortedBlocks];
  blocks.splice(heroIdx + 1, 0, injected); // after the hero, or at index 0 when none
}

const COMPONENTS: Record<StoreBlockType, any> = {
  hero: StoreHero,
  productGrid: ProductGrid,
  featuredProducts: FeaturedProducts,
  textSection: TextSection,
  imageBanner: ImageBanner,
  imageGallery: ImageGallery,
  contactInfo: ContactInfo,
  team: StoreTeam,
  storeActions: StoreActions,
  infoColumns: StoreInfoColumns,
};
---

<div class="store-scope" style={cssVars} data-store-scope>
  <div class="store-grid">
    {blocks.map((block) => {
      const def = BLOCK_REGISTRY[block.type];
      const Comp = COMPONENTS[block.type];
      if (!Comp || !def) return null; // defensive: skip unknown
      // Content-driven blocks size to their content. Flexible blocks honour the
      // editor y-resize as a min-height; the block's card fills it (see
      // `.store-block > *` in global.css) so the extra height is WHITESPACE
      // INSIDE the bordered panel (matching the editor), not an empty gap below.
      const minH = def.contentHeight ? null : Math.max(0, block.layout.h - 12);
      // Pin each block to its designed column (x) + width (w) so the storefront
      // matches the editor (WYSIWYG). CSS collapses to full-width on mobile.
      const colStart = block.layout.x + 1;
      const base = `--col-span:${block.layout.w};--col-start:${colStart}`;
      const style = minH ? `${base};min-height:${minH}px` : base;
      return (
        <div class="store-block" style={style} data-block-type={block.type}>
          <Comp store={store} props={block.props} listings={listings} assets={assets} members={members} viewer={viewer} />
        </div>
      );
    })}
  </div>
</div>
