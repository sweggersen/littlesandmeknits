---
// Hero block: logo + store name + tagline, over an optional background image.
// The header band uses --store-header-bg (a dark colour by theme convention);
// text is white for guaranteed contrast over the band / image overlay.
//
// Security notes:
//  - Background + logo are rendered as <img> elements (never CSS url()), and the
//    chosen images are resolved by asset id against THIS store's own assets, so
//    props can only reference images that belong to this store — never an
//    arbitrary storage path. A store-level banner_path / logo_path is the
//    fallback for the pre-builder default.
//  - The dark overlay is built by heroOverlayCss() from ONLY a clamped 0-100
//    number + a bounded style key. No user string ever reaches the inline style.
import { projectPhotoUrl, resizedImageUrl } from '../../../lib/storage';
import {
  heroOverlayCss,
  coerceOverlayStyle,
  sanitizeHeroElements,
  HERO_DEFAULT_ELEMENTS,
  HERO_LOGO_SCALE_DEFAULT,
  type HeroElementKey,
} from '../../../lib/store-blocks';
import type { StoreBlockProps } from './types';

const { store, props = {}, assets = [] } = Astro.props as StoreBlockProps;

// The tagline is the hero field's value; an empty field means no tagline (so it
// matches the builder). Only an unset tagline (undefined) falls back to the
// store-level tagline.
const tagline = props.tagline === undefined ? (store.tagline ?? '') : String(props.tagline).trim();
const showBanner = props.showBanner !== false;

// The hero title is an explicit value that changes only the hero display, never
// the store's real name. `undefined` (never set) falls back to the store name;
// an empty string means the owner intentionally shows NO title.
const title = props.title === undefined ? store.name : String(props.title).trim();

// Background image: prefer an explicitly chosen store asset (resolved by id
// against this store's assets), else fall back to the store banner when the
// banner toggle is on.
const bgAsset =
  typeof props.bgImage === 'string' && props.bgImage
    ? assets.find((a) => a.id === props.bgImage) ?? null
    : null;
const bgPath = bgAsset?.path ?? (showBanner ? store.banner_path : null);
const bgUrl = bgPath
  ? resizedImageUrl(projectPhotoUrl(bgPath), 1600, { height: 520, resize: 'cover' })
  : null;

// Logo: prefer a chosen store asset, else the store's own logo_path.
const logoAsset =
  typeof props.logo === 'string' && props.logo
    ? assets.find((a) => a.id === props.logo) ?? null
    : null;
const logoPath = logoAsset?.path ?? store.logo_path;
const logoUrl = logoPath ? projectPhotoUrl(logoPath) : null;

// Overlay: validated rgba/gradient built only from the clamped strength + style.
const overlayStyle = coerceOverlayStyle(props.overlayStyle);
const overlayCss = heroOverlayCss(props.overlay, overlayStyle);

const ctaText = typeof props.ctaText === 'string' ? props.ctaText.trim() : '';
const ctaHref = typeof props.ctaHref === 'string' ? props.ctaHref.trim() : '';
// Only http(s) or same-site paths — never javascript:/data: URIs.
const cta = ctaText && /^(https?:\/\/|\/)/i.test(ctaHref) ? { text: ctaText, href: ctaHref } : null;

// Free layout: a validated map of bounded-int positions (or undefined). Re-run
// the sanitiser here so this component never trusts a raw prop, even if a caller
// forgot to sanitise. When present, at sm+ each sub-element is absolutely placed
// by percent; below sm we ignore it and fall back to the centred stack (CSS
// only, no JS). Absent map = render exactly as before.
const positions = sanitizeHeroElements(props.elements);
const hasPositions = !!positions;
// Build an inline style that carries ONLY clamped integers as CSS custom
// properties — no user string is ever concatenated in.
function elStyle(key: HeroElementKey): string | undefined {
  if (!positions) return undefined;
  const p = positions[key] ?? HERO_DEFAULT_ELEMENTS[key];
  let s = `--hx:${p.x}%;--hy:${p.y}%;`;
  if (key === 'logo') s += `--hw:${p.scale ?? HERO_LOGO_SCALE_DEFAULT}%;`;
  return s;
}
---

<section class="store-hero relative overflow-hidden rounded-3xl" style="background-color: var(--store-header-bg);">
  {bgUrl && (
    <img src={bgUrl} alt="" aria-hidden="true"
      class="absolute inset-0 w-full h-full object-cover" loading="eager" decoding="async" data-hero-bg />
  )}
  {overlayCss !== 'transparent' && (
    <div class="absolute inset-0" style={`background: ${overlayCss};`} data-hero-overlay></div>
  )}
  <div
    class="hero-inner relative px-6 py-12 sm:px-10 sm:py-16 flex flex-col items-center text-center text-white"
    data-hero-free={hasPositions ? '' : undefined}
  >
    {logoUrl && (
      /* A store logo can be any shape (wide, tall, square) — show it in full
         (object-contain, natural aspect) capped in size, never circle-cropped. */
      <img src={logoUrl} alt={store.name} style={elStyle('logo')}
        class="hero-el hero-el-logo max-h-20 sm:max-h-28 max-w-[min(100%,24rem)] w-auto object-contain mb-5 drop-shadow" data-hero-logo />
    )}
    {title && (
      <h1 class="hero-el hero-el-title font-serif leading-tight" style={`font-family: var(--font-display); font-size: calc(clamp(1.875rem, 4vw + 0.5rem, 3rem) * var(--store-heading-scale));${elStyle('title') ?? ''}`}>{title}</h1>
    )}
    {tagline && <p class="hero-el hero-el-subtitle mt-3 max-w-xl text-white/85 text-base sm:text-lg" style={elStyle('subtitle')}>{tagline}</p>}
    {cta && (
      <a href={cta.href} rel="nofollow" style={elStyle('cta')}
        class="hero-el hero-el-cta mt-6 inline-block btn-primary px-6 py-2.5 rounded-full text-sm font-medium">{cta.text}</a>
    )}
  </div>
</section>

<style>
  /* Free layout only kicks in at sm+ and only when the owner has placed at least
     one element (data-hero-free). Below sm we keep the centred flex stack the
     base classes give us, so the hero never breaks on phones — no JS involved. */
  @media (min-width: 640px) {
    .hero-inner[data-hero-free] {
      display: block;
      min-height: 22rem;
    }
    .hero-inner[data-hero-free] .hero-el {
      position: absolute;
      left: var(--hx);
      top: var(--hy);
      transform: translate(-50%, -50%);
      margin: 0;
      max-width: 90%;
    }
    .hero-inner[data-hero-free] .hero-el-logo {
      width: var(--hw);
      max-width: none;
      max-height: none;
    }
  }
</style>
