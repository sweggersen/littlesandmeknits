---
// Contact info: location, email, website + social links. All values come from
// the store row and are rendered as escaped text / attribute-escaped hrefs.
// Only http(s) links are surfaced (guards against javascript: URIs).
import type { StoreBlockProps } from './types';

const { store, props = {} } = Astro.props as StoreBlockProps;
const heading = typeof props.heading === 'string' && props.heading.trim() ? props.heading.trim() : 'Kontakt';

const httpOnly = (u: string | null | undefined): string | null =>
  typeof u === 'string' && /^https?:\/\//i.test(u.trim()) ? u.trim() : null;

const socials = [
  { label: 'Nettside', url: httpOnly(store.website_url) },
  { label: 'Instagram', url: httpOnly(store.instagram_url) },
  { label: 'Etsy', url: httpOnly(store.etsy_url) },
  { label: 'Pinterest', url: httpOnly(store.pinterest_url) },
  { label: 'TikTok', url: httpOnly(store.tiktok_url) },
].filter((s) => s.url);

const email = typeof store.contact_email === 'string' && store.contact_email.includes('@') ? store.contact_email : null;
---

<section class="rounded-3xl p-6" style="background-color: var(--color-surface); border: 1px solid var(--store-border);">
  <h2 class="font-serif text-xl mb-4" style="font-family: var(--font-display);">{heading}</h2>
  <dl class="space-y-3 text-sm">
    {store.location_city && (
      <div>
        <dt class="label-eyebrow mb-0.5">Sted</dt>
        <dd style="color: var(--color-charcoal);">{store.location_city}</dd>
      </div>
    )}
    {email && (
      <div>
        <dt class="label-eyebrow mb-0.5">E-post</dt>
        <dd><a href={`mailto:${email}`} class="hover:underline" style="color: var(--color-primary);">{email}</a></dd>
      </div>
    )}
    {store.contact_phone && (
      <div>
        <dt class="label-eyebrow mb-0.5">Telefon</dt>
        <dd style="color: var(--color-charcoal);">{store.contact_phone}</dd>
      </div>
    )}
  </dl>
  {socials.length > 0 && (
    <ul class="flex flex-wrap gap-2 mt-4 list-none p-0 m-0">
      {socials.map((s) => (
        <li>
          <a href={s.url!} target="_blank" rel="noopener nofollow"
            class="inline-block px-3 py-1.5 rounded-full text-xs font-medium"
            style="background-color: var(--store-accent); color: var(--color-primary-fg);">{s.label}</a>
        </li>
      ))}
    </ul>
  )}
</section>
