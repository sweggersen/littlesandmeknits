---
// Live theme switcher for /dev/theme. Sets `data-theme` on <html>, which the
// :root[data-theme="…"] blocks in global.css pick up — reskinning the whole
// page (nav, footer, showcase) at runtime with zero component edits. DB-free.
import { SITE_THEME } from '../../lib/theme';
const themes = [
  { id: 'kveld', label: 'Kveld', hint: 'Mørkt tema (standard)' },
  { id: 'natt', label: 'Natt', hint: 'Dypt mørkt, høy kontrast' },
  { id: 'linen', label: 'Linen', hint: 'Lyst, nøytralt' },
  { id: 'solnedgang', label: 'Solnedgang', hint: 'Varmt, høy kontrast' },
  { id: 'skog', label: 'Skog', hint: 'Skogsgrønt' },
  { id: 'hav', label: 'Hav', hint: 'Kjølig teal' },
  { id: 'lavendel', label: 'Lavendel', hint: 'Mykt lilla' },
];
---

<div
  class="sticky top-4 z-30 bg-surface/90 backdrop-blur-md rounded-full border border-sage-500/15 shadow-sm px-2 py-2 inline-flex items-center gap-1"
  data-theme-switcher
  data-site-default={SITE_THEME}
>
  <span class="label-eyebrow px-3 hidden sm:inline">Tema</span>
  {themes.map((t) => (
    <button
      type="button"
      data-theme-btn={t.id}
      title={t.hint}
      class="px-4 py-2 rounded-full text-sm font-medium text-charcoal/70 hover:text-charcoal transition-colors data-[active]:bg-primary data-[active]:text-primary-fg"
    >
      {t.label}
    </button>
  ))}
</div>

<script>
  // Follows the CLAUDE.md view-transitions rule: re-attach on every
  // astro:page-load, never a direct call (page-load also fires on first load).
  function initThemePlayground() {
    const wrap = document.querySelector('[data-theme-switcher]');
    if (!wrap) return;
    const buttons = Array.from(wrap.querySelectorAll('[data-theme-btn]')) as HTMLElement[];
    const STORAGE_KEY = 'lm-playground-theme';
    // The site-wide default (from src/lib/theme.ts) — restored on leave so the
    // playground never leaks a preview onto the rest of the site.
    const SITE_DEFAULT = wrap.getAttribute('data-site-default') || 'kveld';

    function apply(theme: string) {
      document.documentElement.setAttribute('data-theme', theme);
      buttons.forEach((b) => {
        if (b.getAttribute('data-theme-btn') === theme) b.setAttribute('data-active', '');
        else b.removeAttribute('data-active');
      });
      try { sessionStorage.setItem(STORAGE_KEY, theme); } catch {}
    }

    buttons.forEach((b) => {
      b.addEventListener('click', () => apply(b.getAttribute('data-theme-btn') || SITE_DEFAULT));
    });

    // Default to the site default unless the visitor already picked one.
    let initial = SITE_DEFAULT;
    try { initial = sessionStorage.getItem(STORAGE_KEY) || SITE_DEFAULT; } catch {}
    apply(initial);

    // Restore the site default when navigating away, so the playground never
    // leaks its preview onto the rest of the site. Registered here so it can
    // close over SITE_DEFAULT; guarded to bind once.
    if (!(window as any).__themeResetBound) {
      (window as any).__themeResetBound = true;
      document.addEventListener('astro:before-swap', () => {
        document.documentElement.setAttribute('data-theme', SITE_DEFAULT);
      });
    }
  }
  document.addEventListener('astro:page-load', initThemePlayground);
</script>
