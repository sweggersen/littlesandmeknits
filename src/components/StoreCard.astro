---
// Store directory card. Used in the /market/stores grid and the "Anbefalte"
// strip. The favourite heart posts to /api/stores/favorite (store-fav
// controller); the red dot marks a favourited store with new listings since
// the user last opened it.
import StarRating from './StarRating.astro';
import VerifiedBadge from './VerifiedBadge.astro';
import { projectPhotoUrl } from '../lib/storage';
import type { StoreCardData } from '../lib/services/store-directory';

interface Props {
  store: StoreCardData;
  showFav?: boolean;
}

const { store, showFav = false } = Astro.props;
const {
  slug, name, tagline, logo_path, location_city, postnummer, verified, featured,
  rating_avg, rating_count, active_listing_count, isFavorite, hasNewSinceSeen, distanceKm,
} = store;

const locationBits = [location_city, postnummer].filter(Boolean).join(' ');
const distanceLabel =
  distanceKm == null ? null : distanceKm < 1 ? '< 1 km' : `~${Math.round(distanceKm)} km`;
---

<li class="relative">
  <a
    href={`/market/store/${slug}`}
    class="flex items-start gap-3 bg-surface rounded-2xl border border-sage-500/10 hover:border-sage-500/30 transition-colors p-3 h-full"
  >
    <div class="relative w-14 h-14 rounded-xl bg-oatmeal/60 border border-sage-500/15 overflow-hidden shrink-0">
      {logo_path ? (
        <img src={projectPhotoUrl(logo_path)} alt="" class="w-full h-full object-cover" />
      ) : (
        <div class="w-full h-full flex items-center justify-center font-serif text-lg text-charcoal/40">
          {name?.[0]?.toUpperCase() ?? '?'}
        </div>
      )}
      {hasNewSinceSeen && (
        <span
          title="Nye annonser siden sist"
          class="absolute -top-1 -right-1 w-3 h-3 rounded-full bg-terracotta-500 ring-2 ring-surface"
        ></span>
      )}
    </div>

    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-1.5">
        <h2 class="font-serif text-base truncate">{name}</h2>
        {verified && (
          <span title="Verifisert butikk" class="inline-flex items-center justify-center w-5 h-5 rounded-full bg-sage-500/20 text-sage-700 shrink-0">
            <VerifiedBadge size={13} />
          </span>
        )}
        {featured && (
          <span title="Partner" class="text-[9px] font-bold uppercase tracking-widest bg-terracotta-500/15 text-terracotta-600 px-1.5 py-0.5 rounded-full shrink-0">Partner</span>
        )}
      </div>

      {tagline && <p class="text-xs text-charcoal/55 truncate mt-0.5">{tagline}</p>}

      <div class="flex items-center gap-2 mt-1.5 flex-wrap">
        {rating_count > 0 ? (
          <span class="flex items-center gap-1">
            <StarRating rating={Math.round(rating_avg)} size={12} />
            <span class="text-[11px] text-charcoal/50">{rating_avg.toFixed(1)} ({rating_count})</span>
          </span>
        ) : (
          <span class="text-[11px] text-charcoal/40">Ingen vurderinger</span>
        )}
        {active_listing_count > 0 && (
          <span class="text-[11px] text-charcoal/50">· {active_listing_count} {active_listing_count === 1 ? 'annonse' : 'annonser'}</span>
        )}
      </div>

      {(locationBits || distanceLabel) && (
        <p class="text-[10px] uppercase tracking-widest text-charcoal/40 mt-1">
          {locationBits}{locationBits && distanceLabel ? ' · ' : ''}{distanceLabel}
        </p>
      )}
    </div>
  </a>

  {showFav && (
    <button
      type="button"
      data-store-fav={store.id}
      aria-label={isFavorite ? 'Fjern butikk fra favoritter' : 'Lagre butikk som favoritt'}
      aria-pressed={isFavorite ? 'true' : 'false'}
      title={isFavorite ? 'Fjern fra favoritter' : 'Lagre som favoritt'}
      style={isFavorite ? 'color: var(--color-primary);' : ''}
      class:list={['absolute top-2 right-2 w-8 h-8 rounded-full bg-surface/80 backdrop-blur-sm flex items-center justify-center transition-colors hover:bg-surface',
        !isFavorite && 'text-charcoal/30']}
    >
      <svg width="16" height="16" viewBox="0 0 24 24" fill={isFavorite ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
    </button>
  )}
</li>
