---
// Shared scaffold for every "compose"/create screen (new project, new yarn, new
// listing, new oppdrag, new store, ...): a chevron back-link, a serif title, an
// optional subtitle, and a consistent max-w-2xl column. The form (and any
// alerts / wizard steps) goes in the default slot. Each page still supplies its
// own section layout (StudioLayout / MarketplaceShell / Layout) around this.
interface Props {
  title: string;
  backHref?: string;
  backLabel?: string;
  subtitle?: string;
}
const { title, backHref, backLabel, subtitle } = Astro.props;
---

<div class="max-w-2xl mx-auto">
  {backHref && (
    <a href={backHref}
      class="inline-flex items-center gap-1.5 -ml-1 mb-4 px-1 py-1 text-sm font-medium text-charcoal/65 hover:text-terracotta-500 transition-colors">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6" /></svg>
      {backLabel}
    </a>
  )}
  <h1 class:list={['font-serif text-3xl sm:text-4xl', subtitle ? 'mb-2' : 'mb-8']}>{title}</h1>
  {subtitle && <p class="text-charcoal/55 mb-6">{subtitle}</p>}
  <slot />
</div>
