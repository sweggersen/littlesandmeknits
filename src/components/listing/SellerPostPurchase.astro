---
// What the seller (owner) sees in the right column when their listing
// has been sold: ship form with buyer address, shipped confirmation,
// or dispute notice. Extracted from market/listing/[id].astro.
//
// Render only on the isOwner branch — the caller is responsible for
// that gate.

import { isTrackedTier } from '../../lib/shipping';

interface Listing {
  id: string;
  status: string;
  shipping_option?: string | null;
}

// The order is the source of truth for the buyer's shipping address +
// tracking + dispute detail (PII no longer lives on the catalog row).
interface Order {
  shipping_name: string | null;
  shipping_address: string | null;
  shipping_postal_code: string | null;
  shipping_city: string | null;
  tracking_code: string | null;
  dispute_reason: string | null;
}

interface Props {
  listing: Listing;
  order: Order | null;
  /** True when a real carrier (Posten/Bring) is configured — enables the
   *  "generate label" flow; otherwise the seller uses manual tracking. */
  carrierAvailable?: boolean;
  /** Bring label link, once a label has been generated (shipped view). */
  labelUrl?: string | null;
}
const { listing, order, carrierAvailable = false, labelUrl = null } = Astro.props;
// Tracked parcels require a tracking number at ship time (fraud control).
const trackingRequired = isTrackedTier(listing.shipping_option as never);
// Offer the one-click label only when a carrier is live AND we have the buyer's
// address to print on it.
const canGenerateLabel = carrierAvailable
  && !!(order?.shipping_name && order?.shipping_address && order?.shipping_postal_code && order?.shipping_city);
---

{listing.status === 'reserved' && (
  <section class="bg-surface rounded-3xl p-5 border border-sage-500/10 space-y-4">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2.5 h-2.5 rounded-full bg-sage-500"></span>
      <h2 class="font-serif text-lg">Noen har kjøpt varen din!</h2>
    </div>
    {order?.shipping_name && (
      <div class="bg-oatmeal/40 rounded-2xl p-4 text-sm space-y-1">
        <p class="text-[10px] font-bold uppercase tracking-widest text-charcoal/45 mb-2">Send til</p>
        <p class="font-medium">{order?.shipping_name}</p>
        {order?.shipping_address && <p class="text-charcoal/70">{order?.shipping_address}</p>}
        {order?.shipping_postal_code && order?.shipping_city && (
          <p class="text-charcoal/70">{`${order.shipping_postal_code} ${order.shipping_city}`}</p>
        )}
      </div>
    )}
    {canGenerateLabel && (
      <div class="space-y-3">
        <p class="text-sm text-charcoal/65">Lag en fraktetikett med Posten, så fyller vi inn kjøpers adresse og sporingsnummeret automatisk.</p>
        <form method="post" action={`/api/marketplace/listings/${listing.id}/book-shipping`}>
          <button type="submit" class="w-full bg-primary text-primary-fg px-6 py-3 rounded-full text-sm font-medium hover:bg-primary-hover transition-colors">
            Generer fraktetikett med Posten
          </button>
        </form>
        <div class="flex items-center gap-3 text-[11px] text-charcoal/40">
          <span class="flex-1 h-px bg-sage-500/15"></span>eller legg inn sporing manuelt<span class="flex-1 h-px bg-sage-500/15"></span>
        </div>
      </div>
    )}
    {!canGenerateLabel && (
      <p class="text-sm text-charcoal/65">Pakk og send varen, og legg inn sporingskoden.</p>
    )}
    <form method="post" action={`/api/marketplace/listings/${listing.id}/ship`} class="space-y-3">
      <input name="tracking_code" type="text" maxlength="50" required={trackingRequired}
        placeholder={trackingRequired ? 'Sporingsnummer fra Posten/Bring' : 'Sporingskode (valgfritt)'}
        class="w-full bg-linen rounded-xl px-4 py-3 text-sm border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors" />
      {trackingRequired && (
        <p class="text-[11px] text-charcoal/45">Pakken sendes med sporing — sporingsnummeret beskytter deg mot falske «ikke mottatt»-krav.</p>
      )}
      <button type="submit" class="w-full bg-primary text-primary-fg px-6 py-3 rounded-full text-sm font-medium hover:bg-primary-hover transition-colors">
        Merk som sendt
      </button>
    </form>
  </section>
)}

{listing.status === 'shipped' && (
  <div class="bg-sage-100 text-sage-900 rounded-2xl p-4 text-sm">
    Varen er sendt. Venter på at kjøper bekrefter mottak.
    {order?.tracking_code && (
      <p class="mt-1">Sporingskode: <span class="font-mono">{order?.tracking_code}</span></p>
    )}
    {labelUrl && (
      <a href={labelUrl} target="_blank" rel="noopener" class="inline-block mt-2 text-sage-900 underline hover:text-terracotta-500 transition-colors">
        Last ned fraktetikett →
      </a>
    )}
  </div>
)}

{listing.status === 'disputed' && (
  <div class="bg-amber-50 text-amber-900 rounded-2xl p-4 text-sm">
    Kjøper har åpnet en tvist. Saken er under behandling av admin.
    {order?.dispute_reason && (
      <p class="mt-1 text-xs">Grunn: {order?.dispute_reason}</p>
    )}
  </div>
)}
