---
import Layout from '../layouts/Layout.astro';

// Branded not-found page. Astro renders this for any unmatched route (SSR),
// replacing the bare "Not found" plain-text responses.
---

<Layout title="Fant ikke siden · Strikketorget" lang="nb" noindex>
  <div class="bg-linen min-h-[70vh] grid place-items-center px-6">
    <div class="max-w-md text-center">
      <div class="mx-auto mb-6 w-14 h-14 rounded-full bg-sage-100 grid place-items-center text-sage-900">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" />
        </svg>
      </div>
      <p class="text-[11px] font-bold uppercase tracking-widest text-charcoal/45 mb-2">404</p>
      <h1 class="font-serif text-3xl mb-3">Vi fant ikke siden</h1>
      <p class="text-charcoal/60 mb-8">Siden finnes ikke, eller den er flyttet. Sjekk lenken, eller gå tilbake.</p>
      <div class="flex items-center justify-center gap-3">
        <a href="/" class="btn-primary px-5 py-2.5 rounded-full text-sm font-medium">Til forsiden</a>
        <a href="/market" class="px-5 py-2.5 rounded-full text-sm font-medium border border-sage-500/25 text-charcoal/70 hover:border-sage-500/50 transition-colors">Til Strikketorget</a>
      </div>
    </div>
  </div>
</Layout>
