---
import Layout from '../layouts/Layout.astro';
import type { Section } from '../lib/sections';

// Landing shown when a section is gated off (FLAG_SECTION_<NAME>=off).
// Reached via a middleware redirect; ?s=<section> tailors the copy.
const s = (Astro.url.searchParams.get('s') ?? '') as Section;

const COPY: Partial<Record<Section, { title: string; body: string }>> = {
  brukt: { title: 'Brukt kommer snart', body: 'Kjøp og salg av brukte strikkeplagg åpner om kort tid.' },
  nytt: { title: 'Nytt kommer snart', body: 'Nye, håndlagde strikkeplagg åpner om kort tid.' },
  oppdrag: { title: 'Oppdrag kommer snart', body: '«Strikk for meg» — bestill et plagg fra en strikker — åpner om kort tid.' },
  butikker: { title: 'Butikker kommer snart', body: 'Butikker for registrerte virksomheter åpner om kort tid.' },
  oppskrifter: { title: 'Oppskrifter kommer snart', body: 'Nedlastbare strikkeoppskrifter åpner om kort tid.' },
};
const { title, body } = COPY[s] ?? {
  title: 'Kommer snart',
  body: 'Denne delen er ikke åpen ennå. Kom tilbake om kort tid.',
};
---

<Layout title={`${title} — Strikketorget`} lang="nb" noindex>
  <div class="bg-linen min-h-[70vh] grid place-items-center px-6">
    <div class="max-w-md text-center">
      <div class="mx-auto mb-6 w-14 h-14 rounded-full bg-sage-100 grid place-items-center text-sage-900">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
        </svg>
      </div>
      <h1 class="font-serif text-3xl mb-3">{title}</h1>
      <p class="text-charcoal/60 mb-8">{body}</p>
      <div class="flex items-center justify-center gap-3">
        <a href="/market" class="btn-primary px-5 py-2.5 rounded-full text-sm font-medium">Til Strikketorget</a>
        <a href="/studio" class="px-5 py-2.5 rounded-full text-sm font-medium border border-sage-500/25 text-charcoal/70 hover:border-sage-500/50 transition-colors">Til Strikkestua</a>
      </div>
    </div>
  </div>
</Layout>
