---
import Layout from '../../../../layouts/Layout.astro';
import MarketplaceShell from '../../../../components/MarketplaceShell.astro';
import ListingCard from '../../../../components/ListingCard.astro';
import EmptyState from '../../../../components/EmptyState.astro';
import StoreHeader from '../../../../components/store/StoreHeader.astro';
import StoreSidebar from '../../../../components/store/StoreSidebar.astro';
import StorePageRenderer from '../../../../components/store/StorePageRenderer.astro';
import StoreOwnerPanel from '../../../../components/store/StoreOwnerPanel.astro';
import ReportButton from '../../../../components/ReportButton.astro';
import { REPORT_TARGET_LABEL } from '../../../../lib/labels';
import { hasBuilderConfig } from '../../../../lib/store-blocks';
import type { Store, PublicStorefront } from '../../../../lib/types/stores';
import { buildServiceContext } from '../../../../lib/services/context';
import { getStoreBySlugAdmin, getPublicStorefront } from '../../../../lib/services/stores';
import { getMyRole } from '../../../../lib/services/store-members';
import { can } from '../../../../lib/services/store-permissions';
import { projectPhotoUrl } from '../../../../lib/storage';
import { storeShareMeta } from '../../../../lib/seo';
import { createServerSupabase, createAdminSupabase } from '../../../../lib/supabase';
import { env } from '../../../../lib/env';

const slug = Astro.params.slug ?? '';
const ctx = await buildServiceContext(Astro.request, Astro.cookies);
const supabase = createServerSupabase({ request: Astro.request, cookies: Astro.cookies });

// Look up the store regardless of status (we may still want to show a
// preview to moderators or members of pending/suspended stores).
const admin = createAdminSupabase(env.SUPABASE_SERVICE_ROLE_KEY);
const rawStore = ctx ? await getStoreBySlugAdmin(ctx, slug) : null;

// For anonymous viewers: only active stores are visible.
let storefront;
let previewBanner: 'pending_review' | 'suspended' | 'archived' | null = null;
if (ctx && rawStore) {
  const isActive = rawStore.status === 'active' && !rawStore.deleted_at;
  let canPreview = false;
  if (!isActive) {
    // Members can always preview their own store
    const role = await getMyRole(ctx, rawStore.id);
    if (role) canPreview = true;
    // Moderators/admins can preview any store
    if (!canPreview) {
      const { data: viewer } = await admin.from('profiles').select('role').eq('id', ctx.user.id).maybeSingle();
      if (viewer?.role === 'moderator' || viewer?.role === 'admin') canPreview = true;
    }
    if (!canPreview) return new Response('Not found', { status: 404 });
    previewBanner = rawStore.deleted_at ? 'archived' : rawStore.status as 'pending_review' | 'suspended';
  }

  // Build the same payload getPublicStorefront returns, using admin so
  // preview works even for non-active stores.
  const { data: members } = await admin
    .from('store_members')
    .select('user_id, public_title, role, profiles:profiles!store_members_user_id_fkey(display_name, avatar_path)')
    .eq('store_id', rawStore.id)
    .eq('visible_on_storefront', true);
  storefront = {
    store: rawStore,
    publicMembers: (members ?? []).map((m: any) => ({
      user_id: m.user_id,
      public_title: m.public_title,
      role: m.role,
      display_name: m.profiles?.display_name ?? null,
      avatar_path: m.profiles?.avatar_path ?? null,
    })),
  };
} else if (ctx) {
  // ctx exists but store doesn't (or RLS blocks). Try the public-only path.
  const res = await getPublicStorefront(ctx, slug);
  if (!res.ok) return new Response('Not found', { status: 404 });
  storefront = res.data;
} else {
  // Anonymous viewer — only active stores visible.
  const { data: store } = await supabase
    .from('stores')
    .select('*')
    .eq('slug', slug)
    .eq('status', 'active')
    .is('deleted_at', null)
    .maybeSingle();
  if (!store) return new Response('Not found', { status: 404 });
  const { data: members } = await supabase
    .from('store_members')
    .select('user_id, public_title, role, profiles:profiles!store_members_user_id_fkey(display_name, avatar_path)')
    .eq('store_id', store.id)
    .eq('visible_on_storefront', true);
  storefront = {
    store,
    publicMembers: (members ?? []).map((m: any) => ({
      user_id: m.user_id,
      public_title: m.public_title,
      role: m.role,
      display_name: m.profiles?.display_name ?? null,
      avatar_path: m.profiles?.avatar_path ?? null,
    })),
  };
}

// `storefront` is assembled from several branches (admin row, public Pick,
// anon row); the row-shaped branches carry theme/page_config while the
// public-Pick edge case doesn't (there it's simply absent -> default
// storefront). Coerce to Store so the builder reads a stable shape.
const { store, publicMembers } = storefront as {
  store: Store;
  publicMembers: PublicStorefront['publicMembers'];
};

const PREVIEW_LABEL: Record<string, string> = {
  pending_review: 'Forhåndsvisning — butikken venter på moderering',
  suspended: 'Forhåndsvisning — butikken er suspendert',
  archived: 'Forhåndsvisning — butikken er slettet',
};

// Active listings
const { data: listings } = await supabase
  .from('listings')
  .select('id, title, price_nok, hero_photo_path, status, kind, size_label, category, escrow_enabled, can_meet')
  .eq('store_id', store.id)
  .eq('status', 'active')
  .order('promoted_until', { ascending: false, nullsFirst: false })
  .order('published_at', { ascending: false })
  .limit(60);

// Aggregate review rating
const { data: reviews } = await supabase
  .from('seller_reviews')
  .select('rating')
  .eq('store_id', store.id);
const reviewCount = (reviews ?? []).length;
const avgRating = reviewCount > 0
  ? ((reviews ?? []).reduce((s, r) => s + r.rating, 0) / reviewCount).toFixed(1)
  : null;

// Apply accent_color via a CSS variable so descendants can reference it.
// Fallback to the terracotta brand colour when no accent is set.
const accentStyle = `--store-accent: ${store.accent_color ?? '#C97B5D'};`;

// Draft preview: a store's branding editor can preview UNPUBLISHED changes via
// ?preview=draft. Gated to editors (manager+); every other viewer always sees
// the live storefront, so a half-edited draft never leaks to the public.
const wantsDraftPreview = Astro.url.searchParams.get('preview') === 'draft';
let previewDraft = false;
if (wantsDraftPreview && ctx && rawStore) {
  const editorRole = await getMyRole(ctx, store.id);
  if (can.editBranding(editorRole)) previewDraft = true;
}
const activeTheme = previewDraft ? (store.theme_draft ?? store.theme) : store.theme;
const activePageConfig = previewDraft ? (store.page_config_draft ?? store.page_config) : store.page_config;

// Page-builder storefront: if the store has a non-empty, sanitisable
// page_config, render the themed block layout instead of the default
// storefront. Stores without config keep the existing storefront untouched.
const useBuilder = hasBuilderConfig(activePageConfig);
let storeAssets: Array<{ id: string; path: string; kind: string | null; alt: string | null }> = [];
if (useBuilder) {
  const { data: assetRows } = await admin
    .from('store_assets')
    .select('id, path, kind, alt, position')
    .eq('store_id', store.id)
    .order('position');
  storeAssets = assetRows ?? [];
}

// Owners/members viewing a suspended (frozen) store get a link straight
// into the moderator thread, if any.
let frozenThreadId: string | null = null;
if (previewBanner === 'suspended' && ctx) {
  const { data: t } = await supabase.from('moderation_threads')
    .select('id').eq('target_type', 'store').eq('target_id', store.id)
    .eq('status', 'open').order('created_at', { ascending: false }).limit(1).maybeSingle();
  frozenThreadId = t?.id ?? null;
}

const storeShare = storeShareMeta({
  name: store.name,
  tagline: store.tagline,
  logoUrl: store.logo_path ? projectPhotoUrl(store.logo_path) : null,
});
---

<Layout title={`${store.name} — Strikketorget`} description={storeShare.description} ogImage={storeShare.ogImage} lang="nb">
  <MarketplaceShell>
    {previewDraft && (
      <div class="mb-4 bg-sage-500/10 border border-sage-500/30 text-charcoal rounded-2xl px-4 py-3 text-sm flex items-center gap-2 flex-wrap">
        <span>✏️</span>
        <span>Forhåndsvisning av utkast. Endringene er ikke publisert enda.</span>
        <a href={`/market/store/${store.slug}/admin/butikk`} class="underline font-medium ml-auto">Tilbake til redigering</a>
      </div>
    )}
    {previewBanner && (
      <div class="mb-4 bg-amber-50 border border-amber-200 text-amber-900 rounded-2xl px-4 py-3 text-sm flex items-center gap-2 flex-wrap">
        <span class="text-amber-600">👁</span>
        <span>{PREVIEW_LABEL[previewBanner]}</span>
        {previewBanner === 'suspended' && frozenThreadId && (
          <a href={`/market/moderasjon/${frozenThreadId}`} class="underline font-medium ml-auto">Åpne samtalen med moderator &rarr;</a>
        )}
      </div>
    )}

    {useBuilder ? (
      <StorePageRenderer
        store={store}
        theme={activeTheme}
        pageConfig={activePageConfig}
        listings={listings ?? []}
        assets={storeAssets}
        members={publicMembers}
      />
    ) : (
    <div style={accentStyle}>
      <StoreHeader store={store} />

      <!-- Body grid: listings + sidebar -->
      <div class="mt-8 sm:mt-10 grid grid-cols-1 lg:grid-cols-3 gap-6 sm:gap-8">
        <!-- Listings + about -->
        <div class="lg:col-span-2 space-y-8">
          {store.description && (
            <section class="bg-surface rounded-3xl border border-sage-500/10 p-6">
              <h2 class="font-serif text-xl mb-3">Om butikken</h2>
              <p class="text-charcoal/75 whitespace-pre-wrap">{store.description}</p>
            </section>
          )}

          <section>
            <div class="flex items-baseline justify-between mb-4">
              <h2 class="font-serif text-2xl">Annonser</h2>
              {listings && listings.length > 0 && (
                <span class="text-sm text-charcoal/55">{listings.length} aktive</span>
              )}
            </div>
            {(!listings || listings.length === 0) ? (
              <EmptyState message="Ingen aktive annonser akkurat nå." />
            ) : (
              <ul class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4 list-none p-0 m-0">
                {listings.map((l: any) => (
                  <ListingCard
                    id={l.id}
                    title={l.title}
                    price={l.price_nok}
                    imgUrl={l.hero_photo_path ? projectPhotoUrl(l.hero_photo_path) : undefined}
                    meta={l.size_label}
                    escrowEnabled={l.escrow_enabled ?? false}
                    canMeet={l.can_meet ?? false}
                  />
                ))}
              </ul>
            )}
          </section>

          <StoreOwnerPanel members={publicMembers} />
        </div>

        <StoreSidebar store={store} reviewCount={reviewCount} avgRating={avgRating} />
      </div>
    </div>
    )}

    <!-- Report control: sits at the very bottom for both storefront paths.
         Outside .store-scope so it reads as neutral site chrome, not themed. -->
    <div class="mt-10 flex justify-center">
      <ReportButton targetType="store" targetId={store.id} label={REPORT_TARGET_LABEL.store} />
    </div>
  </MarketplaceShell>
</Layout>
