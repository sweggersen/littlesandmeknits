---
import Layout from '../../layouts/Layout.astro';
import MarketplaceShell from '../../components/MarketplaceShell.astro';
import ListingCard from '../../components/ListingCard.astro';
import DirectoryToolbar from '../../components/DirectoryToolbar.astro';
import FilterPanel from '../../components/FilterPanel.astro';
import LoadMore from '../../components/LoadMore.astro';
import FavScript from '../../components/FavScript.astro';
import EmptyState from '../../components/EmptyState.astro';
import ImpressionTracker from '../../components/ImpressionTracker.astro';
import { createServerSupabase } from '../../lib/supabase';
import { projectPhotoUrl } from '../../lib/storage';
import { CATEGORY_LABEL, CONDITION_LABEL } from '../../lib/labels';
import { LISTING_SORT_OPTIONS } from '../../lib/listing-sort';
import { runListingDirectory } from '../../lib/services/listing-directory';

const PAGE_SIZE = 24;
const url = Astro.url;
const category = url.searchParams.get('kategori');
const search = url.searchParams.get('q')?.trim();
const prisMin = parseInt(url.searchParams.get('pris_min') ?? '', 10);
const prisMax = parseInt(url.searchParams.get('pris_max') ?? '', 10);
const ageMin = parseInt(url.searchParams.get('alder_min') ?? '', 10);
const ageMax = parseInt(url.searchParams.get('alder_max') ?? '', 10);
const sortParam = url.searchParams.get('sort') ?? 'nyeste';
const offsetRaw = parseInt(url.searchParams.get('cursor') ?? '', 10);
const offset = Number.isFinite(offsetRaw) && offsetRaw > 0 ? offsetRaw : 0;

const supabase = createServerSupabase({ request: Astro.request, cookies: Astro.cookies });
const user = Astro.locals.user;

const { listings, hasMore, located } = await runListingDirectory(
  { supabase, user: user ? { id: user.id } : null },
  {
    kind: 'pre_loved',
    sort: sortParam,
    offset,
    pageSize: PAGE_SIZE,
    filters: {
      search, category,
      prisMin: Number.isFinite(prisMin) ? prisMin : null,
      prisMax: Number.isFinite(prisMax) ? prisMax : null,
      ageMin: Number.isFinite(ageMin) ? ageMin : null,
      ageMax: Number.isFinite(ageMax) ? ageMax : null,
    },
  },
);

// "Nærmest" only when the buyer is located.
const sortOptions = located ? [...LISTING_SORT_OPTIONS, { value: 'naer', label: 'Nærmest' }] : LISTING_SORT_OPTIONS;
const validSort = new Set(sortOptions.map((o) => o.value));
const sort = validSort.has(sortParam) ? sortParam : 'nyeste';

let favIds: string[] = [];
if (user) {
  try {
    const { data } = await supabase.from('favorites').select('item_id').eq('user_id', user.id).eq('item_type', 'listing');
    favIds = data?.map(f => f.item_id) ?? [];
  } catch {}
}

const hasFilters = !!(search || category || Number.isFinite(prisMin) || Number.isFinite(prisMax) || Number.isFinite(ageMin) || Number.isFinite(ageMax));
const filterCount = [search, category, Number.isFinite(prisMin) && prisMin, Number.isFinite(prisMax) && prisMax, Number.isFinite(ageMin) && ageMin, Number.isFinite(ageMax) && ageMax].filter(Boolean).length;

const nextPageParams = (() => {
  if (!hasMore) return null;
  const p = new URLSearchParams(url.searchParams);
  p.set('cursor', String(offset + PAGE_SIZE));
  return p.toString();
})();
---

<Layout title="Gjenbruk — Strikketorget" lang="nb">
  <MarketplaceShell current="brukt">
    <DirectoryToolbar
      eyebrow="Brukt"
      eyebrowClass="text-used-500"
      title="Gjenbruk"
      subtitle="Strikketøy søker nytt hjem."
      sortOptions={sortOptions}
      sortValue={sort}
      hasFilters={hasFilters}
      filterCount={filterCount}
      ctaHref="/market/listing/new?kind=pre_loved"
      ctaLabel="+ Ny"
    >
      <FilterPanel search={search} category={category} hasFilters={hasFilters} showAge params={url.searchParams} resetHref="/market/used" />
    </DirectoryToolbar>

    {listings.length === 0 ? (
      <EmptyState message="Ingen treff. Prøv et annet filter." />
    ) : (
      <Fragment>
      <ul data-listing-grid class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
        {listings.map((l) => {
          const condLabel = l.condition ? CONDITION_LABEL[l.condition] ?? l.condition : null;
          const meta = `${CATEGORY_LABEL[l.category] ?? l.category} · str. ${l.size_label}${condLabel ? ` · ${condLabel}` : ''}`;
          return (
            <ListingCard
              id={l.id}
              title={l.title}
              price={l.price_nok}
              imgUrl={projectPhotoUrl(l.hero_photo_path)}
              meta={meta}
              distanceKm={l.distanceKm}
              showFav={!!user}
              isFav={favIds.includes(l.id)}
              escrowEnabled={l.escrow_enabled ?? false}
              canMeet={l.can_meet ?? false}
              promoted={!!(l.promoted_until && new Date(l.promoted_until) > new Date() && l.promotion_tier === 'highlight')}
            />
          );
        })}
      </ul>
      <LoadMore params={nextPageParams} />
      </Fragment>
    )}
  </MarketplaceShell>
  <FavScript />
  <ImpressionTracker source="category" />
</Layout>
