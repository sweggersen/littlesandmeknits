---
import Layout from '../../layouts/Layout.astro';
import MarketplaceShell from '../../components/MarketplaceShell.astro';
import ListingCard from '../../components/ListingCard.astro';
import FilterPanel from '../../components/FilterPanel.astro';
import LoadMore from '../../components/LoadMore.astro';
import FavScript from '../../components/FavScript.astro';
import EmptyState from '../../components/EmptyState.astro';
import Alert from '../../components/Alert.astro';
import ImpressionTracker from '../../components/ImpressionTracker.astro';
import { createServerSupabase } from '../../lib/supabase';
import { projectPhotoUrl } from '../../lib/storage';
import { CATEGORY_LABEL } from '../../lib/labels';
import { LISTING_SORT_OPTIONS, normalizeListingSort, listingSortOrders } from '../../lib/listing-sort';

const PAGE_SIZE = 24;
const url = Astro.url;
const category = url.searchParams.get('kategori');
const search = url.searchParams.get('q')?.trim();
const prisMin = parseInt(url.searchParams.get('pris_min') ?? '', 10);
const prisMax = parseInt(url.searchParams.get('pris_max') ?? '', 10);
const sort = normalizeListingSort(url.searchParams.get('sort'));
const offsetRaw = parseInt(url.searchParams.get('cursor') ?? '', 10);
const offset = Number.isFinite(offsetRaw) && offsetRaw > 0 ? offsetRaw : 0;

const supabase = createServerSupabase({ request: Astro.request, cookies: Astro.cookies });
const user = Astro.locals.user;

let q = supabase
  .from('listings')
  .select('id, title, price_nok, size_label, hero_photo_path, category, escrow_enabled, can_meet, published_at, promoted_until, promotion_tier')
  .eq('status', 'active')
  .eq('kind', 'ready_made');
for (const [col, opts] of listingSortOrders(sort)) q = q.order(col, opts);

if (search) q = q.ilike('title', `%${search}%`);
if (category) q = q.eq('category', category as 'cardigan' | 'lue' | 'bukser' | 'sokker' | 'genser' | 'teppe' | 'votter' | 'kjole' | 'annet');
if (Number.isFinite(prisMin)) q = q.gte('price_nok', prisMin);
if (Number.isFinite(prisMax)) q = q.lte('price_nok', prisMax);

const { data: rows, error: listErr } = await q.range(offset, offset + PAGE_SIZE);
if (listErr) console.error('new.astro listings query failed', listErr);
const hasMore = (rows ?? []).length > PAGE_SIZE;
const listings = (rows ?? []).slice(0, PAGE_SIZE);

let favIds: string[] = [];
if (user) {
  try {
    const { data } = await supabase.from('favorites').select('item_id').eq('user_id', user.id).eq('item_type', 'listing');
    favIds = data?.map(f => f.item_id) ?? [];
  } catch {}
}

const hasFilters = !!(search || category || Number.isFinite(prisMin) || Number.isFinite(prisMax));
const filterCount = [search, category, Number.isFinite(prisMin) && prisMin, Number.isFinite(prisMax) && prisMax].filter(Boolean).length;

const nextPageParams = (() => {
  if (!hasMore) return null;
  const p = new URLSearchParams(url.searchParams);
  p.set('cursor', String(offset + PAGE_SIZE));
  return p.toString();
})();
---

<Layout title="Ferdigstrikket — Strikketorget" lang="nb">
  <MarketplaceShell current="nytt">
    <form method="get">
      <div class="flex items-center justify-between gap-4 flex-wrap mb-2">
        <div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-new-500 mb-1">Nytt</p>
          <h1 class="font-serif text-4xl sm:text-5xl">Ferdigstrikket</h1>
        </div>
        <div class="flex items-center gap-2 shrink-0">
          <label for="sort" class="text-[10px] font-bold uppercase tracking-widest text-charcoal/45">Sorter</label>
          <select id="sort" name="sort" data-listing-sort
            class="bg-surface rounded-full px-4 py-2 text-sm border border-sage-500/15 focus:border-sage-500/40 focus:outline-none">
            {LISTING_SORT_OPTIONS.map((o) => <option value={o.value} selected={sort === o.value}>{o.label}</option>)}
          </select>
          <button type="button" data-toggle-filter
            class:list={['flex items-center gap-1.5 px-3 py-2 rounded-full text-sm border transition-colors',
              hasFilters ? 'bg-primary text-primary-fg border-charcoal' : 'bg-surface text-charcoal/65 border-sage-500/15 hover:border-sage-500/30']}>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
            Filter{hasFilters ? ` (${filterCount})` : ''}
          </button>
          <a href="/market/listing/new?kind=ready_made" class="btn-primary px-4 py-2 rounded-full text-sm font-medium">+ Ny</a>
        </div>
      </div>
      <p class="text-charcoal/65 mb-6">Nystrikkede plagg fra strikkere, klare til bruk.</p>

      <FilterPanel search={search} category={category} hasFilters={hasFilters} params={url.searchParams} resetHref="/market/new" />
    </form>

    {listErr ? (
      <Alert type="error" class="my-4">Vi klarte ikke å hente annonsene akkurat nå. Prøv igjen om litt.</Alert>
    ) : listings.length === 0 ? (
      <EmptyState message={hasFilters ? 'Ingen treff. Prøv et annet filter.' : 'Ingen ferdigstrikkede plagg ennå. Kom tilbake snart.'} />
    ) : (
      <Fragment>
      <ul data-listing-grid class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
        {listings.map((l) => (
          <ListingCard
            id={l.id}
            title={l.title}
            price={l.price_nok}
            imgUrl={projectPhotoUrl(l.hero_photo_path)}
            meta={`${CATEGORY_LABEL[l.category] ?? l.category} · str. ${l.size_label}`}
            showFav={!!user}
            isFav={favIds.includes(l.id)}
            escrowEnabled={l.escrow_enabled ?? false}
            canMeet={l.can_meet ?? false}
            promoted={!!(l.promoted_until && new Date(l.promoted_until) > new Date() && l.promotion_tier === 'highlight')}
          />
        ))}
      </ul>
      <LoadMore params={nextPageParams} />
      </Fragment>
    )}
  </MarketplaceShell>
  <FavScript />
  <ImpressionTracker source="category" />
  <script>
    import { init } from '../../lib/client/controllers/listing-directory';
    import { registerController } from '../../lib/client/dom';
    registerController(init);
  </script>
</Layout>
