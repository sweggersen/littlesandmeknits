---
import Layout from '../../../layouts/Layout.astro';
import MarketplaceShell from '../../../components/MarketplaceShell.astro';
import ComposePage from '../../../components/ComposePage.astro';
import { requireUser } from '../../../lib/auth';
import { createServerSupabase } from '../../../lib/supabase';

const guard = await requireUser(Astro);
if (guard instanceof Response) return guard;
const user = guard;

const targetKnitterId = Astro.url.searchParams.get('strikker') || null;
let targetKnitterName: string | null = null;
if (targetKnitterId) {
  const supabase = createServerSupabase({ request: Astro.request, cookies: Astro.cookies });
  const { data: knitter } = await supabase
    .from('profiles')
    .select('display_name')
    .eq('id', targetKnitterId)
    .maybeSingle();
  targetKnitterName = knitter?.display_name ?? null;
}

const CATEGORIES = [
  { value: 'genser', label: 'Genser' },
  { value: 'cardigan', label: 'Cardigan' },
  { value: 'lue', label: 'Lue' },
  { value: 'votter', label: 'Votter' },
  { value: 'sokker', label: 'Sokker' },
  { value: 'teppe', label: 'Teppe' },
  { value: 'kjole', label: 'Kjole' },
  { value: 'bukser', label: 'Bukser' },
  { value: 'annet', label: 'Annet' },
];
---

<Layout title="Nytt oppdrag · Strikketorget" lang="nb">
  <MarketplaceShell current="oppdrag">
      <ComposePage
        title="Ny forespørsel"
        subtitle="Beskriv hva du ønsker strikket, så kan strikkere gi tilbud på pris og leveringstid."
        backHref="/market/commissions"
        backLabel="Oppdrag"
      >

      {targetKnitterName && (
        <div class="bg-sage-100/50 rounded-2xl p-4 border border-sage-500/15 mb-6">
          <p class="text-sm text-charcoal/65">
            Privat forespørsel til <span class="font-medium text-charcoal">{targetKnitterName}</span>. Kun denne strikkeren ser forespørselen.
          </p>
        </div>
      )}

      <form method="post" action="/api/marketplace/commissions/create" enctype="multipart/form-data" data-astro-reload class="bg-surface rounded-3xl p-6 sm:p-8 border border-sage-500/10 space-y-6">
        {targetKnitterId && <input type="hidden" name="target_knitter_id" value={targetKnitterId} />}

        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Tittel *</span>
          <input name="title" type="text" required maxlength="80" placeholder="F.eks. Sondre cardigan i str. 92"
            class="w-full bg-surface rounded-xl px-4 py-3 text-base border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors" />
        </label>

        <div class="grid grid-cols-2 gap-4">
          <label class="block">
            <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Kategori *</span>
            <select name="category" required class="w-full bg-surface rounded-xl px-4 py-3 text-base border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors">
              <option value="">Velg…</option>
              {CATEGORIES.map((c) => (
                <option value={c.value}>{c.label}</option>
              ))}
            </select>
          </label>

          <label class="block">
            <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Størrelse *</span>
            <input name="size_label" type="text" required maxlength="20" placeholder="F.eks. 92, 2 år, M"
              class="w-full bg-surface rounded-xl px-4 py-3 text-base border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors" />
          </label>
        </div>

        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Farge / fargevalg</span>
          <input name="colorway" type="text" maxlength="100" placeholder="F.eks. naturhvit, lys rosa, terracotta"
            class="w-full bg-surface rounded-xl px-4 py-3 text-base border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors" />
        </label>

        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Oppskrift eller referanse (valgfritt)</span>
          <input name="pattern_reference" type="text" maxlength="300" placeholder="Navn på oppskrift eller lenke til inspirasjon"
            class="w-full bg-surface rounded-xl px-4 py-3 text-base border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors" />
          <span class="block text-[11px] text-charcoal/45 mt-1.5">Skriv navnet på en oppskrift, eller lim inn en lenke. Ikke last opp selve oppskrifts-PDF-en.</span>
        </label>

        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Referansebilder (valgfritt)</span>
          <input name="reference_images" type="file" accept="image/*" multiple
            class="w-full text-sm text-charcoal/70 file:mr-3 file:rounded-full file:border-0 file:bg-oatmeal file:px-4 file:py-2 file:text-sm file:font-medium file:text-charcoal hover:file:bg-oatmeal/70 file:cursor-pointer" />
          <span class="block text-[11px] text-charcoal/45 mt-1.5">Del inspirasjonsbilder så strikkeren ser hva du ser for deg. Opptil 6 bilder.</span>
        </label>

        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Garnpreferanse</span>
          <input name="yarn_preference" type="text" maxlength="200" placeholder="F.eks. Sandnes Peer Gynt, merinoull"
            class="w-full bg-surface rounded-xl px-4 py-3 text-base border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors" />
        </label>

        <label class="flex items-center gap-3 cursor-pointer">
          <input type="checkbox" name="yarn_provided_by_buyer" value="1"
            class="w-5 h-5 rounded border-sage-500/30 text-terracotta-500 focus:ring-terracotta-500/30" />
          <span class="text-sm">Jeg sender garnet selv</span>
        </label>

        <label class="flex items-start gap-3 cursor-pointer">
          <input type="checkbox" name="requires_agreement" value="1"
            class="mt-0.5 w-5 h-5 rounded border-sage-500/30 text-terracotta-500 focus:ring-terracotta-500/30" />
          <span class="text-sm">
            Krev en avtale før betaling
            <span class="block text-[11px] text-charcoal/45">Du og strikkeren blir enige om detaljene før pengene trekkes.</span>
          </span>
        </label>

        <div class="grid grid-cols-2 gap-4">
          <label class="block">
            <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Budsjett min (NOK) *</span>
            <input name="budget_nok_min" type="number" required min="0" step="1" placeholder="300"
              class="w-full bg-surface rounded-xl px-4 py-3 text-base border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors" />
          </label>
          <label class="block">
            <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Budsjett maks (NOK) *</span>
            <input name="budget_nok_max" type="number" required min="0" step="1" placeholder="800"
              class="w-full bg-surface rounded-xl px-4 py-3 text-base border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors" />
          </label>
        </div>

        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Trengs innen</span>
          <input name="needed_by" type="date"
            class="w-full bg-surface rounded-xl px-4 py-3 text-base border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors" />
        </label>

        <label class="block">
          <span class="block text-xs font-bold uppercase tracking-widest text-charcoal/55 mb-2">Beskrivelse</span>
          <textarea name="description" rows="4" maxlength="2000" placeholder="Ekstra detaljer om hva du ønsker, f.eks. mønster, garntype, spesielle ønsker…"
            class="w-full bg-surface rounded-xl px-4 py-3 text-base border border-sage-500/15 focus:outline-none focus:border-sage-500 transition-colors resize-none"></textarea>
        </label>

        <div class="flex items-center justify-between gap-3 pt-2 border-t border-sage-500/10 mt-6">
          <a href="/market/commissions" class="text-sm font-medium text-charcoal/60 hover:text-charcoal transition-colors px-4 py-2">Avbryt</a>
          <div class="flex-1"></div>
          <button type="submit" class="bg-primary text-primary-fg px-6 py-3 rounded-full text-sm font-medium hover:bg-primary-hover transition-colors">Publiser forespørsel →</button>
        </div>
      </form>
      <p class="text-[11px] text-charcoal/45 text-center mt-4">Forespørselen er åpen i 30 dager. Du kan avbryte når som helst.</p>
      </ComposePage>
  </MarketplaceShell>
</Layout>
