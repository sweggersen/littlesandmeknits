---
import Layout from '../../../layouts/Layout.astro';
import MarketplaceShell from '../../../components/MarketplaceShell.astro';
import CommissionCard from '../../../components/CommissionCard.astro';
import DirectoryToolbar from '../../../components/DirectoryToolbar.astro';
import FilterPanel from '../../../components/FilterPanel.astro';
import EmptyState from '../../../components/EmptyState.astro';
import Alert from '../../../components/Alert.astro';
import LoadMore from '../../../components/LoadMore.astro';
import { createServerSupabase } from '../../../lib/supabase';
import { COMMISSION_SORT_OPTIONS, normalizeCommissionSort, commissionSortOrders } from '../../../lib/commission-sort';

const PAGE_SIZE = 24;
const url = Astro.url;
const category = url.searchParams.get('kategori');
const search = url.searchParams.get('q')?.trim();
const budgetMin = parseInt(url.searchParams.get('budsjett_min') ?? '', 10);
const budgetMax = parseInt(url.searchParams.get('budsjett_max') ?? '', 10);
const sort = normalizeCommissionSort(url.searchParams.get('sort'));
const offsetRaw = parseInt(url.searchParams.get('cursor') ?? '', 10);
const offset = Number.isFinite(offsetRaw) && offsetRaw > 0 ? offsetRaw : 0;

const supabase = createServerSupabase({ request: Astro.request, cookies: Astro.cookies });
let q = supabase
  .from('commission_requests')
  .select('id, title, category, size_label, budget_nok_min, budget_nok_max, needed_by, offer_count, created_at, expires_at, buyer_id, profiles!commission_requests_buyer_id_fkey(display_name)')
  .eq('status', 'open');
for (const [col, opts] of commissionSortOrders(sort)) q = q.order(col, opts);

if (search) q = q.ilike('title', `%${search}%`);
if (category) q = q.eq('category', category as 'cardigan' | 'lue' | 'bukser' | 'sokker' | 'genser' | 'teppe' | 'votter' | 'kjole' | 'annet');
if (Number.isFinite(budgetMin)) q = q.gte('budget_nok_max', budgetMin);
if (Number.isFinite(budgetMax)) q = q.lte('budget_nok_min', budgetMax);

const { data: rows, error: reqErr } = await q.range(offset, offset + PAGE_SIZE);
if (reqErr) console.error('commissions/index.astro requests query failed', reqErr);
const hasMore = (rows?.length ?? 0) > PAGE_SIZE;
const requests = (rows ?? []).slice(0, PAGE_SIZE);

const hasFilters = !!(search || category || Number.isFinite(budgetMin) || Number.isFinite(budgetMax));
const filterCount = [search, category, Number.isFinite(budgetMin) && budgetMin, Number.isFinite(budgetMax) && budgetMax].filter(Boolean).length;

const nextPageParams = (() => {
  if (!hasMore) return null;
  const p = new URLSearchParams(url.searchParams);
  p.set('cursor', String(offset + PAGE_SIZE));
  return p.toString();
})();

function expiryDays(expiresAt: string | null): number | null {
  if (!expiresAt) return null;
  return Math.max(0, Math.ceil((new Date(expiresAt).getTime() - Date.now()) / 86400_000));
}
---

<Layout title="Oppdrag · Strikketorget" lang="nb">
  <MarketplaceShell current="oppdrag">
    <DirectoryToolbar
      eyebrow="Strikk for meg"
      eyebrowClass="text-commission-500"
      title="Oppdrag"
      subtitle="Bestill et plagg strikket av en dyktig strikker fra fellesskapet."
      sortOptions={COMMISSION_SORT_OPTIONS}
      sortValue={sort}
      hasFilters={hasFilters}
      filterCount={filterCount}
      ctaHref="/market/commissions/new"
      ctaLabel="+ Nytt oppdrag"
    >
      <FilterPanel search={search} category={category} hasFilters={hasFilters} showBudget params={url.searchParams} resetHref="/market/commissions" />
    </DirectoryToolbar>

    {reqErr ? (
      <Alert type="error" class="my-4">Vi klarte ikke å hente forespørslene akkurat nå. Prøv igjen om litt.</Alert>
    ) : requests.length === 0 ? (
      <EmptyState message={hasFilters ? 'Ingen treff. Prøv et annet filter.' : 'Ingen åpne forespørsler ennå.'} ctaText="Opprett den første" ctaHref="/market/commissions/new" />
    ) : (
      <Fragment>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
        {requests.map((r) => (
          <CommissionCard
            id={r.id}
            title={r.title}
            category={r.category}
            sizeLabel={r.size_label}
            budgetMin={r.budget_nok_min}
            budgetMax={r.budget_nok_max}
            offerCount={r.offer_count}
            buyerName={(r as any).profiles?.display_name ?? 'Anonym'}
            neededBy={r.needed_by}
            daysLeft={expiryDays(r.expires_at)}
          />
        ))}
      </ul>

      <LoadMore params={nextPageParams} />
      </Fragment>
    )}
  </MarketplaceShell>
</Layout>
