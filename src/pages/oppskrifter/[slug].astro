---
// SSR while Oppskrifter is UNLAUNCHED so the middleware section gate can redirect
// /oppskrifter/* to /kommer-snart (a prerendered page bypasses middleware). The
// gate short-circuits before this body renders. Set back to `true` on launch
// (restores getStaticPaths prerendering) + remove from UNLAUNCHED in sections.ts.
export const prerender = false;
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PatternDetail from '../../components/PatternDetail.astro';

export async function getStaticPaths() {
  const patterns = await getCollection('patterns', (p) => !p.data.draft);
  return patterns.map((pattern) => ({
    params: { slug: pattern.id },
    props: { pattern },
  }));
}

const { pattern } = Astro.props;
---

<Layout
  title={`${pattern.data.title.nb} · Littles and Me`}
  description={pattern.data.summary.nb}
  lang="nb"
>
  <PatternDetail pattern={pattern} lang="nb" />
</Layout>
