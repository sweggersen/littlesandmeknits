---
import Layout from '../layouts/Layout.astro';

// Branded error page. Astro renders this when a page throws during SSR,
// replacing the framework's bare error response. Keep it dependency-free: it
// must render even when the thing that failed was a data/Supabase call.
---

<Layout title="Noe gikk galt · Strikketorget" lang="nb" noindex>
  <div class="bg-linen min-h-[70vh] grid place-items-center px-6">
    <div class="max-w-md text-center">
      <div class="mx-auto mb-6 w-14 h-14 rounded-full bg-terracotta-500/15 grid place-items-center text-terracotta-500">
        <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 9v4" /><path d="M12 17h.01" /><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
        </svg>
      </div>
      <p class="text-[11px] font-bold uppercase tracking-widest text-charcoal/45 mb-2">Feil</p>
      <h1 class="font-serif text-3xl mb-3">Noe gikk galt</h1>
      <p class="text-charcoal/60 mb-8">Vi klarte ikke å laste siden akkurat nå. Prøv igjen om litt, eller gå tilbake til forsiden.</p>
      <div class="flex items-center justify-center gap-3">
        <a href="/" class="btn-primary px-5 py-2.5 rounded-full text-sm font-medium">Til forsiden</a>
        <button type="button" data-retry class="px-5 py-2.5 rounded-full text-sm font-medium border border-sage-500/25 text-charcoal/70 hover:border-sage-500/50 transition-colors">Prøv igjen</button>
      </div>
    </div>
  </div>
</Layout>

<script>
  // Progressive enhancement: reload on "Prøv igjen". Inline + guarded so it
  // survives view transitions without double-binding.
  function initRetry() {
    const btn = document.querySelector('[data-retry]');
    if (!btn || (btn as HTMLElement).dataset.wired) return;
    (btn as HTMLElement).dataset.wired = '1';
    btn.addEventListener('click', () => location.reload());
  }
  document.addEventListener('astro:page-load', initRetry);
</script>
